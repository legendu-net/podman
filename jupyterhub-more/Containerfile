FROM quay.io/legendu/jupyterhub-jdk:next

COPY scripts /scripts

RUN dnf install -y --setopt=install_weak_deps=False \
        fzf \
        gopass age \
        gh glab \
        valgrind \
    && /scripts/purge_cache.sh

# Deno
RUN curl -fsSL https://deno.land/install.sh | sh -s -- --no-modify-path -y \
    && mv /root/.deno/bin/deno /usr/local/bin/ \
    && rm -rf /root/.deno/ \
    && deno jupyter --install \
    && mkdir -p /usr/local/share/jupyter/kernels/ \
    && mv /root/.local/share/jupyter/kernels/deno /usr/local/share/jupyter/kernels/ \
    && /scripts/purge_cache.sh

# Rust kernel
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN dnf install -y --setopt=install_weak_deps=False cmake \
    && /scripts/purge_cache.sh
COPY --from=quay.io/legendu/rust-utils:next /usr/local/rustup/ /usr/local/rustup/
COPY --from=quay.io/legendu/rust-utils:next /usr/local/cargo/bin /usr/local/cargo/bin
COPY --from=quay.io/legendu/rust-utils:next /usr/bin/nperf /usr/bin/
COPY --from=quay.io/legendu/rust-utils:next /root/.local/share/jupyter/kernels/rust/ /usr/local/share/jupyter/kernels/rust/

# GoLANG. Binaries are copied from this repo's own golang image (same
# pattern as the Rust kernel above) rather than installed here, so this
# toolbox's golang/golangci-lint are guaranteed to match lint/Containerfile
# exactly -- there's only one place (golang/Containerfile) that actually
# pins GO_VERSION/GOLANGCI_LINT_VERSION. No `icon golang -c` needed: PATH
# already covers /usr/local/go/bin below, so its symlinks into
# /usr/local/bin would add nothing.
ENV PATH=/usr/local/go/bin:$PATH
COPY --from=quay.io/legendu/golang:next /usr/local/go /usr/local/go

# The Ganymede Java kernel
RUN icon download_github_release -r allen-ball/ganymede -k jar -K asc -o /tmp/ganymede.jar \
    && java -jar /tmp/ganymede.jar -i --sys-prefix \
    && mv /opt/venv/share/jupyter/kernels/ganymede-*-java-*/ /usr/local/share/jupyter/kernels/ \
    && sed -i 's_/opt/venv/share/jupyter/kernels/_/usr/local/share/jupyter/kernels/_g' /usr/local/share/jupyter/kernels/ganymede*/kernel.json \
    && rm -f /tmp/ganymede.jar \
    && /scripts/purge_cache.sh

# Lint tools for `lint_repo` (github-rest-api), for local use in this
# toolbox. golangci-lint itself isn't installed here: the golang COPY above
# already puts its own (pinned) golangci-lint on PATH ahead of Fedora's,
# which would otherwise just pull in a second, unused Go toolchain as a
# dependency for nothing.
#
# shellcheck and shfmt are copied from their own official images instead of
# reinstalled here, matching lint/Containerfile. stylua, lychee, and selene
# need no separate copy: they're Rust binaries already picked up by the
# `cargo/bin` copy in the Rust kernel section above, since rust-utils
# installs them too.
ARG SHELLCHECK_VERSION=0.11.0
ARG SHFMT_VERSION=3.13.1
COPY --from=docker.io/koalaman/shellcheck:v${SHELLCHECK_VERSION} /bin/shellcheck /usr/local/bin/shellcheck
COPY --from=docker.io/mvdan/shfmt:v${SHFMT_VERSION} /bin/shfmt /usr/local/bin/shfmt

# Versions pinned to match lint/Containerfile, so this toolbox's lint tools
# don't drift from what CI uses.
ARG TY_VERSION=0.0.14
ARG MDFORMAT_VERSION=0.7.22
ARG MDFORMAT_GFM_VERSION=0.4.1
ARG MDFORMAT_FRONTMATTER_VERSION=2.0.8
ARG CODESPELL_VERSION=2.4.1
RUN pip3 install \
        github_rest_api \
        "mdformat==${MDFORMAT_VERSION}" "mdformat-gfm==${MDFORMAT_GFM_VERSION}" "mdformat-frontmatter==${MDFORMAT_FRONTMATTER_VERSION}" \
        "codespell==${CODESPELL_VERSION}" \
        "ty==${TY_VERSION}" \
    && /scripts/purge_cache.sh
